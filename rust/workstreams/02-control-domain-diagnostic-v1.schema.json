{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runalith:contracts:control-domain-diagnostic:v1",
  "title": "ControlDomainDiagnosticV1",
  "description": "WS2-owned route-specific diagnostic payload. Not a Common Envelope or MCP transport error. domain_code and cause_code remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_code",
    "cause_code"
  ],
  "properties": {
    "domain_code": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "AUTHENTICATION_FAILED",
            "AUTHORITY_UNAVAILABLE",
            "IDEMPOTENCY_CONFLICT",
            "MALFORMED_REQUEST",
            "SUBJECT_MISMATCH"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cause_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
