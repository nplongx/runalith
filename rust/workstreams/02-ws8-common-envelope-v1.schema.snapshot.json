{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runalith:workstreams:08:common-envelope:v1.0.0",
  "title": "Runalith cross-workstream common message envelope v1 (draft)",
  "description": "Unratified Workstream 8 proposal. Domain payload semantics and digest canonicalization remain producer-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_kind",
    "message_type",
    "message_id",
    "producer_id",
    "created_at",
    "correlation_id",
    "effect_class",
    "subject",
    "payload_digest",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "message_kind": {
      "type": "string",
      "enum": [
        "command",
        "event",
        "response"
      ]
    },
    "message_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "causation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "effect_class": {
      "type": "string",
      "enum": [
        "read_only",
        "mutating",
        "observation"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "bindings"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "payload_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "sequence",
        "predecessor_id"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect_class": {
            "const": "mutating"
          }
        },
        "required": [
          "effect_class"
        ]
      },
      "then": {
        "required": [
          "idempotency_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_kind": {
            "const": "response"
          }
        },
        "required": [
          "message_kind"
        ]
      },
      "then": {
        "required": [
          "causation_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ordering": {
            "properties": {
              "sequence": {
                "const": 1
              }
            },
            "required": [
              "sequence"
            ]
          }
        },
        "required": [
          "ordering"
        ]
      },
      "then": {
        "properties": {
          "ordering": {
            "properties": {
              "predecessor_id": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ordering": {
            "properties": {
              "sequence": {
                "minimum": 2
              }
            },
            "required": [
              "sequence"
            ]
          }
        },
        "required": [
          "ordering"
        ]
      },
      "then": {
        "properties": {
          "ordering": {
            "properties": {
              "predecessor_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
