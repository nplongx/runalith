# Copy to /etc/runalith/worker.env and set mode 0600.
RUNALITH_WORKER_ID=worker-01
RUNALITH_WORKER_DATA_DIR=/var/lib/runalith-worker
RUNALITH_CONTROL_URL=https://control.example.com
RUNALITH_CONTROL_TOKEN=replace-with-worker-scoped-token
RUNALITH_WORKER_WORKSPACE_ROOT=/srv/runalith/workspace
RUNALITH_WORKER_WORKSPACE_QUOTA_BYTES=2147483648
RUNALITH_WORKER_WORKSPACE_QUOTA_INODES=100000
RUNALITH_WORKER_QUOTA_HELPER_SOCKET=/run/runalith-quota/quota.sock

RUNALITH_WORKER_CURL_BINARY=/usr/bin/curl
RUNALITH_WORKER_BWRAP_BINARY=/usr/bin/bwrap
RUNALITH_WORKER_EXECUTABLE_ROOTS=/usr/bin,/bin,/usr/sbin,/sbin
RUNALITH_WORKER_ALLOWED_ENV_KEYS=CI,LANG,LC_ALL

RUNALITH_WORKER_TIMEOUT_SECONDS=600
RUNALITH_WORKER_OUTPUT_LIMIT_BYTES=1048576
RUNALITH_WORKER_LEASE_SECONDS=120
RUNALITH_WORKER_POLL_INTERVAL_MS=1000
RUNALITH_WORKER_STOP_TIMEOUT_SECONDS=750

# Per-execution cgroup v2 and tmpfs ceilings. The systemd unit must delegate
# cpu/memory/pids. If omitted, the worker uses its current delegated cgroup.
# RUNALITH_WORKER_CGROUP_ROOT=/sys/fs/cgroup/system.slice/runalith-worker.service
RUNALITH_SANDBOX_MEMORY_MAX_BYTES=1073741824
RUNALITH_SANDBOX_CPU_QUOTA_MICROS=100000
RUNALITH_SANDBOX_CPU_PERIOD_MICROS=100000
RUNALITH_SANDBOX_PIDS_MAX=64
RUNALITH_SANDBOX_SCRATCH_MAX_BYTES=134217728

# The worker will refuse to start unless the privileged project-quota helper
# is reachable and the workspace mount has active ext4/XFS project quotas.

# Optional GitHub Actions adapter. Keep this credential out of the sandbox env allowlist.
# GITHUB_ACTIONS_TOKEN=replace-with-provider-scoped-token
