# Install as /etc/runalith/quota-helper.env with mode 0600, owned by root.
RUNALITH_QUOTA_HELPER_ROOT=/srv/runalith/workspace
RUNALITH_QUOTA_HELPER_REGISTRY=/var/lib/runalith-quota/quota.db
RUNALITH_QUOTA_HELPER_WORKER_UID=1001
# Replace 1001 with the numeric UID returned by: id -u runalith-worker

# Maximum privilege the helper may grant to one execution. Worker requests may
# choose smaller limits, but cannot exceed these root-owned ceilings.
RUNALITH_QUOTA_HELPER_MAX_BYTES=2147483648
RUNALITH_QUOTA_HELPER_MAX_INODES=100000
