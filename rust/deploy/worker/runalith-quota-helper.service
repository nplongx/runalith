[Unit]
Description=Runalith project-quota privilege broker
Requires=runalith-quota-helper.socket
After=local-fs.target runalith-quota-helper.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/runalith/quota-helper.env
StateDirectory=runalith-quota
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/libexec/runalith-quota-helper
Restart=on-failure
RestartSec=2s

# This is the only component allowed to administer project quota. The worker
# itself remains unprivileged and can request operations only through a local
# peer-credential-checked socket, under a fixed mount and maximum limits.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_FOWNER
AmbientCapabilities=CAP_SYS_ADMIN CAP_FOWNER
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/runalith/workspace
ReadWritePaths=/var/lib/runalith-quota
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
