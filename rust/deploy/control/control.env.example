# Copy to /etc/runalith/control.env. Keep file mode 0600.
RUNALITH_CONTROL_DATABASE_PATH=/var/lib/runalith-control/workflow.db
RUNALITH_CONTROL_AUTH_FILE=/etc/runalith/control-auth.json
RUNALITH_CONTROL_LISTEN_ADDR=127.0.0.1:8090
RUNALITH_CONTROL_PID_FILE=/run/runalith-control/control.pid
RUNALITH_CONTROL_SHUTDOWN_FILE=/run/runalith-control/control.stop
