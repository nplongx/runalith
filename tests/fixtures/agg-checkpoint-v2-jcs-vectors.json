      "canonical_utf8": "{\"\\r\":1,\"1\":2,\"é\":\"NFD\",\"é\":\"NFC\",\"ö\":3,\"€\":4,\"😀\":5,\"דּ\":6}"
    },
    {
      "name": "ecmascript-number-serialization-safe-integer-profile",
