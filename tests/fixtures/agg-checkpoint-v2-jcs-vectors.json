    "max_nesting_depth": 256,
    "max_json_value_nodes": 1000000,
    "integer_valued_numbers": "safe-integers-only",
    "negative_zero": "reject",
    "unicode": "valid-utf8-and-well-formed-scalars",
    "duplicate_decoded_object_keys": "reject"
  },
