      "input_utf8": "{\"control\":\"\\\\u000f\\\\n\",\"quote\":\"\\\\\\\"\\\\\\\\\",\"slash\":\"/\",\"empty_string\":\"\",\"empty_array\":[],\"empty_object\":{},\"null_value\":null}",
      "canonical_utf8": "{\"control\":\"\\\\u000f\\\\n\",\"empty_array\":[],\"empty_object\":{},\"empty_string\":\"\",\"null_value\":null,\"quote\":\"\\\\\\\"\\\\\\\\\",\"slash\":\"/\"}"
    }
  ],
  "strict_parse_vectors": [
    {
      "name": "positive-and-negative-safe-integer-endpoints",
      "input_utf8": "{\"max\":9007199254740991,\"min\":-9007199254740991}",
      "expected": "accept",
      "canonical_utf8": "{\"max\":9007199254740991,\"min\":-9007199254740991}"
    },
    {
      "name": "duplicate-decoded-key-with-unicode-escape-alias",
      "input_utf8": "{\"a\":1,\"\\u0061\":2}",
      "expected": "reject",
      "error": "duplicate decoded object key"
    },
    {
      "name": "integer-above-safe-range",
      "input_utf8": "{\"n\":9007199254740992}",
      "expected": "reject",
      "error": "safe integer"
    },
    {
      "name": "positive-overflow-to-infinity",
      "input_utf8": "{\"n\":1e400}",
      "expected": "reject",
      "error": "finite"
    },
    {
      "name": "fractional-token-rounded-to-safe-integer",
      "input_utf8": "{\"n\":1.00000000000000000001}",
      "expected": "reject",
      "error": "exactly represented"
    },
    {
      "name": "positive-underflow-rounded-to-zero",
      "input_utf8": "{\"n\":1e-400}",
      "expected": "reject",
      "error": "exactly represented"
    },
    {
      "name": "negative-zero-integer-token",
      "input_utf8": "-0",
      "expected": "reject",
      "error": "negative zero"
    },
    {
      "name": "negative-zero-decimal-token",
      "input_utf8": "-0.0",
      "expected": "reject",
      "error": "negative zero"
    },
    {
      "name": "negative-zero-exponent-token",
      "input_utf8": "-0e0",
      "expected": "reject",
      "error": "negative zero"
    },
    {
      "name": "lone-surrogate-value-escape",
      "input_utf8": "{\"s\":\"\\ud800\"}",
      "expected": "reject",
      "error": "surrogate"
    },
    {
      "name": "trailing-second-json-value",
      "input_utf8": "{} true",
      "expected": "reject",
      "error": "trailing"
    },
    {
      "name": "invalid-utf8-sequence",
      "input_hex": "c328",
      "expected": "reject",
      "error": "UTF-8"
    },
    {
      "name": "utf8-bom-is-not-permitted",
      "input_hex": "efbbbf7b7d",
      "expected": "reject",
      "error": "BOM"
    }
